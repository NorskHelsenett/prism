{
  "name": "prism",
  "version": "0.0.1",
  "private": true,
  "description": "Pentest Report Information Security Management",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p static/.well-known && cp ../CHANGELOG.md static/.well-known && vite dev --host 0.0.0.0",
    "build": "NODE_ENV=production vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^2.0.0",
    "@sveltejs/adapter-static": "^2.0.3",
    "@sveltejs/kit": "^1.27.4",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.46.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^4.2.7",
    "svelte-check": "^3.6.0",
    "typescript": "^5.7.2",
    "vite": "^4.4.2"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.64",
    "@svelte-put/qr": "^1.2.1",
    "@tabler/core": "^1.0.0-beta21",
    "@tabler/icons-svelte": "^2.42.0",
    "@tabler/icons-webfont": "^2.47.0",
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-bubble-menu": "^3.22.3",
    "@tiptap/extension-code-block-lowlight": "^3.22.3",
    "@tiptap/extension-floating-menu": "^3.22.3",
    "@tiptap/extension-highlight": "^3.22.3",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-task-item": "^3.22.3",
    "@tiptap/extension-task-list": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "chart.js": "^4.4.7",
    "chartjs-plugin-datalabels": "^2.2.0",
    "dompurify": "^3.2.2",
    "highlight.js": "^11.11.1",
    "install": "^0.13.0",
    "lowlight": "^3.3.0",
    "marked": "^12.0.0",
    "shx": "^0.3.4",
    "svelte-chartjs": "^3.1.2",
    "svelte-sonner": "^0.3.28",
    "tom-select": "^2.4.1",
    "turndown": "^7.2.4"
  }
}
